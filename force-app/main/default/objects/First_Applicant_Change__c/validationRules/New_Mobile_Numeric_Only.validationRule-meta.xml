<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>New_Mobile_Numeric_Only</fullName>
    <active>true</active>
    <description>Same as the booking rule Mobile_Numeric_Only, for the requested first applicant.</description>
    <errorConditionFormula>AND(OR(ISNEW(), ISCHANGED(New_First_Applicant_Mobile__c)), NOT(ISBLANK(New_First_Applicant_Mobile__c)), NOT(REGEX(New_First_Applicant_Mobile__c, &quot;[0-9]+&quot;)))</errorConditionFormula>
    <errorDisplayField>New_First_Applicant_Mobile__c</errorDisplayField>
    <errorMessage>Mobile number can contain numeric values only.</errorMessage>
</ValidationRule>

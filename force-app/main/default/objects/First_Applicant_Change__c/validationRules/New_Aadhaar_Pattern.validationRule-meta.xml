<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>New_Aadhaar_Pattern</fullName>
    <active>true</active>
    <description>Same as the booking rule Aadhaar_Pattern, for the requested first applicant.</description>
    <errorConditionFormula>AND(OR(ISNEW(), ISCHANGED(New_Aadhaar__c)), NOT(ISBLANK(New_Aadhaar__c)), NOT(REGEX(New_Aadhaar__c, &quot;[0-9]{12}&quot;)))</errorConditionFormula>
    <errorDisplayField>New_Aadhaar__c</errorDisplayField>
    <errorMessage>Aadhaar number must be exactly 12 digits.</errorMessage>
</ValidationRule>

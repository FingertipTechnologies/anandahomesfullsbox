<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Referral_Phone_Number_text_validation</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(REGEX(Referrer_Mobile_No__c, &quot;^[0-9\\+\\-\\s]*$&quot;))</errorConditionFormula>
    <errorDisplayField>Referrer_Mobile_No__c</errorDisplayField>
    <errorMessage>Please enter a valid phone number (numbers only).</errorMessage>
</ValidationRule>

<apex:page standardController="NOC__c" extensions="CapriNocPdfController"
           renderAs="pdf" showHeader="false" sidebar="false"
           standardStylesheets="false" applyHtmlTag="false" applyBodyTag="false">
    <html>
    <head>
        <style type="text/css">
            @page { size: A4; margin: 18mm 16mm 18mm 16mm; }
            body { font-family: Arial, Helvetica, sans-serif; font-size: 10pt; color: #222; }
            p { margin: 0 0 10px 0; line-height: 1.35; }
            table { width: 100%; border-collapse: collapse; margin: 8px 0 14px 0; }
            th, td { border: 1px solid #777; padding: 5px; text-align: left; vertical-align: top; }
            th { background-color: #e9eef5; }
            .date { text-align: right; }
            .section-title { margin: 12px 0 5px 0; font-weight: bold; }
        </style>
    </head>
    <body>
        <apex:outputPanel rendered="{!NOT(ISBLANK(errorMessage))}">
            <p>{!errorMessage}</p>
        </apex:outputPanel>
        <apex:outputPanel rendered="{!ISBLANK(errorMessage)}">
            <p class="date"><b>Date:</b> {!TODAY()}</p>
            <p>
                <b>To,</b><br/>
                Capri Global Capital Limited<br/>
                502, Tower A,<br/>
                Peninsula Business Park,<br/>
                Senapati Bapat Marg,<br/>
                Lower Parel, Mumbai 400 013.
            </p>
            <p>
                <b>Sub:</b> Request for issue of No Objection Certificate for sale of Flat No.
                <b><apex:outputText value="{!booking.Plot__r.Name}"/></b> in the mortgaged property
                <b><apex:outputText value="{!booking.Project__r.Name}"/></b>, situated at
                <apex:outputText value="{!booking.Project__r.Project_Address__c}"/>.
                <apex:outputText value="{!booking.Project__r.Project_description__c}"/>
            </p>
            <p>Dear Sir,</p>
            <p>
                We are pleased to inform you that we have finalized a deal for transfer of the
                above flat. The flat and sale consideration details are set out below.
            </p>
            <p>
                We hereby request you to grant a NOC for entering into an Agreement for Sale and
                for taking a home loan from <b><apex:outputText value="{!booking.Bank_Name__c}"/></b>,
                <apex:outputText value="{!booking.Bank_Branch__c}"/>. Branch contact:
                <apex:outputText value="{!booking.Banker_Contact_Person__c}"/>
                <apex:outputText value="{!booking.Banker_Contact_Number__c}"/>.
            </p>
            <p>The in-principle bank sanction letter in favour of the purchaser is attached for your reference.</p>

            <table>
                <tr><td><b>Flat No.</b></td><td><apex:outputText value="{!booking.Plot__r.Name}"/></td></tr>
                <tr><td><b>Building No.</b></td><td><apex:outputText value="{!booking.Plot__r.Block1__r.Name}"/></td></tr>
                <tr><td><b>Name of Buyer and Address</b></td><td><apex:outputText value="{!booking.First_Applicant_Name__c}"/><br/><apex:outputText value="{!booking.Permanent_Address__c}"/></td></tr>
                <tr><td><b>Date of Allotment</b></td><td><apex:outputText value="{0,date,dd/MM/yyyy}"><apex:param value="{!booking.Booking_Date__c}"/></apex:outputText></td></tr>
                <tr><td><b>Saleable Area (sq. ft.)</b></td><td><apex:outputText value="{!booking.Plot__r.Saleable_Area_Sft__c}"/></td></tr>
                <tr><td><b>Rate (Rs./sq. ft.)</b></td><td><apex:outputText value="{!booking.Rate_Per_Sqft__c}"/></td></tr>
                <tr><td><b>Amenities &amp; Infrastructure</b></td><td><apex:outputText value="{!booking.Cost_Sheet__r.Amenities_Charges__c}"/></td></tr>
                <tr><td><b>Total Sale Consideration</b></td><td><apex:outputText value="{0,number,#,##,##0.00}"><apex:param value="{!booking.Total_Flat_Cost__c}"/></apex:outputText></td></tr>
                <tr><td><b>Amount received in escrow till date</b></td><td><apex:outputText value="{0,number,#,##,##0.00}"><apex:param value="{!totalReceived}"/></apex:outputText></td></tr>
                <tr><td><b>Balance Receivables</b></td><td><apex:outputText value="{0,number,#,##,##0.00}"><apex:param value="{!balanceReceivable}"/></apex:outputText></td></tr>
            </table>

            <p class="section-title">Details of amounts received till date:</p>
            <table>
                <thead>
                    <tr>
                        <th>Receipt</th>
                        <th>Cheque Date</th>
                        <th>Deposited Date</th>
                        <th>Deposited By</th>
                        <th>Cheque / RTGS / NEFT / IMPS Reference</th>
                        <th>Amount</th>
                        <th>Collection Account</th>
                    </tr>
                </thead>
                <tbody>
                    <apex:repeat value="{!receiptLineItems}" var="receipt">
                        <tr>
                            <td><apex:outputText value="{!receipt.Name}"/></td>
                            <td><apex:outputText value="{0,date,dd/MM/yyyy}"><apex:param value="{!receipt.Cheque_Date__c}"/></apex:outputText></td>
                            <td><apex:outputText value="{0,date,dd/MM/yyyy}"><apex:param value="{!receipt.Receipt__r.Receipt_Date__c}"/></apex:outputText></td>
                            <td><apex:outputText value="{!receipt.Payment_From__c}"/></td>
                            <td><apex:outputText value="{!receipt.Cheque_no_Transaction_Number__c}"/></td>
                            <td><apex:outputText value="{0,number,#,##,##0.00}"><apex:param value="{!receipt.Received_Amount__c}"/></apex:outputText></td>
                            <td><apex:outputText value="{!receipt.Receipt__r.Account_Name__r.Name}"/></td>
                        </tr>
                    </apex:repeat>
                </tbody>
            </table>
            <p>Yours truly,</p>
            <p><b>For M/s. ANANDA HOMES</b></p>
            <br/><br/>
            <p>Authorised Signatory</p>
        </apex:outputPanel>
    </body>
    </html>
</apex:page>
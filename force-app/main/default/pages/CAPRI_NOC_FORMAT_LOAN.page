<apex:page standardController="NOC__c" extensions="CapriNocPdfController"
           renderAs="pdf" showHeader="false" sidebar="false"
           standardStylesheets="false" applyHtmlTag="false" applyBodyTag="false">
    <html>
    <head>
        <style type="text/css">
            /* Layout follows "CAPRI NOC FORMAT LOAN.docx"; the top margin leaves room for the letterhead. */
            @page { size: A4; margin: 150pt 72pt 45pt 64pt; }
            body { font-family: 'Times New Roman', Times, serif; font-size: 10pt; color: #000; line-height: 1.2; }
            p { margin: 0; text-align: justify; }
            .gap { height: 11pt; }
            .right { text-align: right; }
            .left { text-align: left; }
            table { width: 100%; border-collapse: collapse; margin: 0; }
            th, td { border: 0.75pt solid #000; padding: 2pt 5pt; text-align: left; vertical-align: top; font-size: 10pt; }
            table.details td { padding: 4pt 5pt; }
            table.receipts th { text-align: center; font-weight: bold; vertical-align: middle; }
            table.receipts td { text-align: center; }
            tr { page-break-inside: avoid; }
        </style>
    </head>
    <body>
        <apex:outputPanel rendered="{!NOT(ISBLANK(errorMessage))}">
            <p>{!errorMessage}</p>
        </apex:outputPanel>
        <apex:outputPanel rendered="{!ISBLANK(errorMessage)}">
            <p class="right">Date:&#160;<apex:outputText value="{0,date,dd/MM/yyyy}"><apex:param value="{!TODAY()}"/></apex:outputText></p>
            <p class="left">To,</p>
            <p class="left">Capri Global Capital Limited</p>
            <p>502, Tower A,</p>
            <p>Peninsula Business Park,</p>
            <p>Senapati Bapat Marg,</p>
            <p>Lower Parel, Mumbai 400 013.</p>
            <div class="gap">&#160;</div>
            <p><b>Sub: Request for issue of No objection Certificate with respect to Sale of Flat No
                {!booking.Plot__r.Name} ({!booking.Plot__r.Saleable_Area_Sft__c} Sq. ft.) in the Mortgaged Property named as
                &#8220;{!booking.Project__r.Name}&#8221; located at {!booking.Project__r.Project_Address__c}</b></p>
            <div class="gap">&#160;</div>
            <p class="left">Dear Sir,</p>
            <div class="gap">&#160;</div>
            <p>We are pleased to inform you that we have finalized a deal for transfer of the following Flat details of which are as under:</p>
            <div class="gap">&#160;</div>

            <table class="details">
                <tr><td style="width:47%">Flat No.</td><td>{!booking.Plot__r.Name}</td></tr>
                <tr><td>Building No.</td><td>{!IF(ISBLANK(booking.Plot__r.Tower_Block__c), booking.Plot__r.Block1__r.Name, booking.Plot__r.Tower_Block__c)}</td></tr>
                <tr><td>Name of the Buyer and his address</td><td><b>{!buyerNames}</b><br/><b>Address:</b> {!booking.Permanent_Address__c}</td></tr>
                <tr><td>Date of Allotment</td><td><apex:outputText value="{0,date,dd-MM-yyyy}"><apex:param value="{!booking.Booking_Date__c}"/></apex:outputText></td></tr>
                <tr><td>Saleable Area in Sq. fts.</td><td>{!booking.Plot__r.Saleable_Area_Sft__c}</td></tr>
                <tr><td>Rate in Rs. /Sq. Ft.</td><td>{!rateText}/-</td></tr>
                <tr><td>Amenities &amp; Infrastructure</td><td>{!amenitiesText}/-</td></tr>
                <tr><td>Total Sale Consideration</td><td>{!considerationText}/-</td></tr>
                <tr><td>Amt received in escrow account till date</td><td>{!totalReceivedText}/-</td></tr>
                <tr><td>Balance Receivables</td><td>{!balanceText}/-</td></tr>
            </table>
            <div class="gap">&#160;</div>

            <p>We hereby request you to grant a NOC for entering into an Agreement for Sale of in respect for the above Flat
                and also grant NOC for taking Home Loan from <b>{!bankName}, &#8220;{!booking.Bank_Branch__c}&#8221;</b>
                and contact person at the branch is &#8220;<b>{!booking.Banker_Contact_Person__c}</b>&#8221;, in respect of above Flat.</p>
            <div class="gap">&#160;</div>
            <p>The in-principle Bank sanction letter in favor of the above purchaser is attached for your ready reference.</p>
            <div class="gap">&#160;</div>
            <p><b>* Details of &#8216;Amount received till date&#8217; is/are as below: -</b></p>
            <div class="gap">&#160;</div>

            <table class="receipts">
                <tr>
                    <th style="width:6%">Sr. No</th>
                    <th style="width:13%">Cheque date</th>
                    <th style="width:13%">Deposited Date</th>
                    <th style="width:12%">Amount Deposited by</th>
                    <th style="width:20%">Cheque No./RTGS/NEFT/IMPS Ref. no. if any</th>
                    <th style="width:13%">Amount</th>
                    <th style="width:23%">Deposited in Master Collection Escrow/Current A/c. /DFT/Others (Please Specify with A/c no.)</th>
                </tr>
                <apex:variable var="rowNo" value="{!0}"/>
                <apex:repeat value="{!receiptLineItems}" var="receipt">
                    <apex:variable var="rowNo" value="{!rowNo + 1}"/>
                    <tr>
                        <td><apex:outputText value="{0,number,0}"><apex:param value="{!rowNo}"/></apex:outputText></td>
                        <td><apex:outputText value="{0,date,dd-MM-yyyy}"><apex:param value="{!receipt.Cheque_Date__c}"/></apex:outputText></td>
                        <td><apex:outputText value="{0,date,dd-MM-yyyy}"><apex:param value="{!receipt.Receipt__r.Receipt_Date__c}"/></apex:outputText></td>
                        <td>{!IF(ISBLANK(receipt.Mode_of_Payment__c), receipt.Payment_From__c, receipt.Mode_of_Payment__c)}</td>
                        <td>{!receipt.Cheque_no_Transaction_Number__c}</td>
                        <td><apex:outputText value="{0,number,#,##0}"><apex:param value="{!receipt.Received_Amount__c}"/></apex:outputText></td>
                        <td>{!receipt.Receipt__r.Account_Name__r.Name}</td>
                    </tr>
                </apex:repeat>
                <tr>
                    <td colspan="5" style="text-align:right"><b>Total</b></td>
                    <td><b>{!totalReceivedText}/-</b></td>
                    <td>&#160;</td>
                </tr>
            </table>
            <div class="gap">&#160;</div>
            <div class="gap">&#160;</div>
            <div style="page-break-inside:avoid">
                <p>Yours truly,</p>
                <div class="gap">&#160;</div>
                <p><b>For M/s. ANANDA HOMES</b></p>
                <div style="height:55pt">&#160;</div>
                <p class="left"><b>Authorised Signatory</b></p>
            </div>
        </apex:outputPanel>
    </body>
    </html>
</apex:page>

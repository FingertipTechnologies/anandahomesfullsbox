<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Secondary_Phone_text_validation</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(REGEX(Secondary_Phone__c , &quot;^[0-9\\+\\-\\s]*$&quot;))</errorConditionFormula>
    <errorDisplayField>Secondary_Phone__c</errorDisplayField>
    <errorMessage>Please enter a valid phone number (numbers only).</errorMessage>
</ValidationRule>

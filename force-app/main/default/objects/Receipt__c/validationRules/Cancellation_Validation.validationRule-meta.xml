<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cancellation_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISNEW(),
  ISPICKVAL(Booking__r.Status__c, &quot;Cancellation&quot;)
)</errorConditionFormula>
    <errorMessage>Receipt Cannot Be Created for Cancelled Bookings</errorMessage>
</ValidationRule>
